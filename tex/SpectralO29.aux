\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Fraction of conjugate pairs with $r_{\mathrm  {eff}}^{(A)} = 3$ in $\End  (H_{\mathrm  {eff}})$, the inferred $d_{\rho }$ via~\eqref  {eq:inversion}, and the median symmetry ratio $|M_j - M_j^{\top }|_F / |M_j|_F$ (Step~A). At $q = 61$ and $q = 151$, $r_{\mathrm  {eff}}^{(A)} = 3$ holds universally with zero inter-pair variance, uniquely identifying $d_{\rho } = 2$.}}{7}{table.1}\protected@file@percent }
\newlabel{tab:results}{{1}{7}{Fraction of conjugate pairs with $\reff ^{(A)} = 3$ in $\End (\Heff )$, the inferred $d_{\rho }$ via~\eqref {eq:inversion}, and the median symmetry ratio $|M_j - M_j^{\top }|_F / |M_j|_F$ (Step~A). At $q = 61$ and $q = 151$, $\reff ^{(A)} = 3$ holds universally with zero inter-pair variance, uniquely identifying $d_{\rho } = 2$}{table.1}{}}
