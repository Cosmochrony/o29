\newlabel{rem:q101}{{6.1}{7}{Anomaly at $q = 101$: multi-sample resolution}{theorem.6.1}{}}
\newlabel{rem:q211}{{6.2}{7}{Anomaly at $q = 211$: two non-generic pairs}{theorem.6.2}{}}
\citation{Beau2026a30}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {(a)} Effective rank $r_{\mathrm  {eff}}^{(A)}$ in $\End  (H_{\mathrm  {eff}}) = \End  (\mathbb  {C}^3)$ per conjugate pair $(c, q{-}c)$, for $q \in \{61, 101, 151, 211\}$ (reproduced from the \texttt  {o29\_rank\_computation.py} pipeline). The dashed green line marks $r_{\mathrm  {eff}}= 3$, the symmetric rank formula prediction for $d_{\rho } = 2$ (spin-$\tfrac  {1}{2}$). At $q = 61$ ($30/30$ pairs) and $q = 151$ ($75/75$ pairs), $r_{\mathrm  {eff}}= 3$ holds universally with zero inter-pair variance. At $q = 101$, $r_{\mathrm  {eff}}= 3$ is the modal result ($64\%$ of pairs); anomalous pairs are confirmed as single-sample Monte Carlo artefacts by a multi-sample analysis (Remark~\ref {rem:q101}). At $q = 211$ ($103/105$ pairs), $r_{\mathrm  {eff}}= 3$ holds for $98\%$ of pairs, with $2$ anomalous pairs giving $r_{\mathrm  {eff}}= 5$, consistent with the same single-sample artefact pattern. \textbf  {(b)} Median normalised eigenvalue spectrum $\lambda _i/\lambda _1$ in $\End  (H_{\mathrm  {eff}})$, computed over all $r_{\mathrm  {eff}}^{(A)} = 3$ pairs at each prime. The two subleading eigenvalues satisfy $\lambda _2/\lambda _1 \approx \lambda _3/\lambda _1 \approx \tfrac  {1}{2}$, confirming the invariant structure $[\lambda _1 : \lambda _2 : \lambda _3] = [1 : \tfrac  {1}{2} : \tfrac  {1}{2}]$ of O28~\cite  {Beau2026a32}. Eigenvalues $\lambda _4, \ldots  , \lambda _9$ lie below the $1\%$ threshold (dotted red line) by more than two orders of magnitude.}}{8}{figure.1}\protected@file@percent }
\newlabel{fig:reff}{{1}{8}{\textbf {(a)} Effective rank $\reff ^{(A)}$ in $\End (\Heff ) = \End (\mathbb {C}^3)$ per conjugate pair $(c, q{-}c)$, for $q \in \{61, 101, 151, 211\}$ (reproduced from the \texttt {o29\_rank\_computation.py} pipeline). The dashed green line marks $\reff = 3$, the symmetric rank formula prediction for $d_{\rho } = 2$ (spin-$\tfrac {1}{2}$). At $q = 61$ ($30/30$ pairs) and $q = 151$ ($75/75$ pairs), $\reff = 3$ holds universally with zero inter-pair variance. At $q = 101$, $\reff = 3$ is the modal result ($64\%$ of pairs); anomalous pairs are confirmed as single-sample Monte Carlo artefacts by a multi-sample analysis (Remark~\ref {rem:q101}). At $q = 211$ ($103/105$ pairs), $\reff = 3$ holds for $98\%$ of pairs, with $2$ anomalous pairs giving $\reff = 5$, consistent with the same single-sample artefact pattern. \textbf {(b)} Median normalised eigenvalue spectrum $\lambda _i/\lambda _1$ in $\End (\Heff )$, computed over all $\reff ^{(A)} = 3$ pairs at each prime. The two subleading eigenvalues satisfy $\lambda _2/\lambda _1 \approx \lambda _3/\lambda _1 \approx \tfrac {1}{2}$, confirming the invariant structure $[\lambda _1 : \lambda _2 : \lambda _3] = [1 : \tfrac {1}{2} : \tfrac {1}{2}]$ of O28~\cite {Beau2026a32}. Eigenvalues $\lambda _4, \ldots , \lambda _9$ lie below the $1\%$ threshold (dotted red line) by more than two orders of magnitude}{figure.1}{}}
